rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only the admin account can write or delete.
    // Replace with the UID from Firebase Authentication -> Users.
    // For more than one admin: request.auth.uid in ['uid1', 'uid2']
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'KXlbQA84PhReXRnsXbe4crNz3pE2';
    }

    // Learners read approved questions. Only the admin can write, delete,
    // or see unapproved ones.
    match /quizQuestions/{id} {
      allow read: if resource.data.approved == true || isAdmin();
      allow write: if isAdmin();
    }

    // Learners read subjects. Only the admin writes.
    match /subjects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form: anyone can send a message, only the admin can read.
    match /contacts/{id} {
      allow create: if request.resource.data.keys().hasOnly(
          ['name', 'email', 'phone', 'category', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // Everything else is blocked. Add a rule above for any new collection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
